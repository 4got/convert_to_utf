# convert.py path config. Copy to .env and adjust.
# Priority: CLI (--src/--dst/--log) -> environment -> .env -> auto from script location.
# All keys are optional; whatever is omitted is derived automatically.

# Source site root (auto: two levels above this script)
SOURCE_PATH="/var/www/example.ru/data/www/example.ru"

# Destination root (auto: <SOURCE_PATH>.utf)
DEST_PATH="/var/www/example.ru/data/www/example.ru.utf"

# CSV log path (auto: convert.log next to the script)
# LOG_PATH="/var/www/example.ru/data/www/example.ru/py/convert_to_utf/convert.log"
